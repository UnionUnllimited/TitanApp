<?xml version="1.0" encoding="utf-8"?>
<!-- Colours come from @color/widget_*, so the widget follows the system theme. -->
<LinearLayout xmlns:android="http://schemas.android.com/apk/res/android"
    android:id="@+id/widget_root"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/widget_bg"
    android:gravity="center_vertical"
    android:orientation="horizontal"
    android:paddingStart="12dp"
    android:paddingTop="12dp"
    android:paddingEnd="8dp"
    android:paddingBottom="12dp">

    <!-- The server's round flag; the logo when there is no server yet. -->
    <ImageView
        android:id="@+id/widget_flag"
        android:layout_width="36dp"
        android:layout_height="36dp"
        android:contentDescription="@null"
        android:src="@drawable/logo" />

    <LinearLayout
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="10dp"
        android:layout_marginEnd="4dp"
        android:layout_weight="1"
        android:orientation="vertical">

        <TextView
            android:id="@+id/widget_status"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Не подключено"
            android:textColor="@color/widget_text"
            android:textSize="15sp"
            android:textStyle="bold" />

        <TextView
            android:id="@+id/widget_server"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:ellipsize="end"
            android:maxLines="1"
            android:text="Titan VPS"
            android:textColor="@color/widget_text_secondary"
            android:textSize="12sp" />
    </LinearLayout>

    <ImageButton
        android:id="@+id/widget_prev"
        android:layout_width="28dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="Предыдущий сервер"
        android:scaleType="center"
        android:src="@drawable/ic_chevron_left" />

    <ImageView
        android:id="@+id/widget_button"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:background="@drawable/widget_btn_off"
        android:contentDescription="Вкл / Выкл"
        android:padding="12dp"
        android:src="@drawable/ic_power" />

    <ImageButton
        android:id="@+id/widget_next"
        android:layout_width="28dp"
        android:layout_height="48dp"
        android:background="@android:color/transparent"
        android:contentDescription="Следующий сервер"
        android:scaleType="center"
        android:src="@drawable/ic_chevron_right" />
</LinearLayout>
