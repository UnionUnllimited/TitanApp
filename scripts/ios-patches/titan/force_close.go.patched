package v2rayhttp

// Titan patch: upstream reaches into golang.org/x/net/http2 internals with go:linkname,
// which the newer x/net that Xray needs no longer has (the link fails). Closing idle
// connections is enough here (v2ray HTTP transports aren't used by the app).

import (
	"net/http"
	"reflect"

	E "github.com/sagernet/sing/common/exceptions"

	"golang.org/x/net/http2"
)

func ResetTransport(rawTransport http.RoundTripper) http.RoundTripper {
	switch transport := rawTransport.(type) {
	case *http.Transport:
		transport.CloseIdleConnections()
		return transport.Clone()
	case *http2.Transport:
		transport.CloseIdleConnections()
		return transport
	default:
		panic(E.New("unknown transport type: ", reflect.TypeOf(transport)))
	}
}
