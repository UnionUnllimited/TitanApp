# Remnawave panel URL and API token (Panel → API tokens)
REMNAWAVE_URL=https://panel.example.com
REMNAWAVE_TOKEN=

# Your Telegram bot
BOT_USERNAME=TitanVPS_bot
# Random string shared with the bot: openssl rand -hex 32
BOT_SECRET=

# SMTP for e-mail login codes
SMTP_HOST=smtp.yandex.ru
SMTP_PORT=465
SMTP_USER=no-reply@titanvps.ru
SMTP_PASSWORD=
SMTP_FROM=TitanVPS <no-reply@titanvps.ru>
SMTP_STARTTLS=false

# Telegram Login Widget: bot token (only used to verify signatures) and the public
# HTTPS address of this server. In @BotFather: /setdomain → the host of PUBLIC_URL.
BOT_TOKEN=
PUBLIC_URL=https://auth.titanvps.ru
