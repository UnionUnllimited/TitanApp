# Скопируйте в .env:  cp env.example .env

# Токен НОВОГО бота от @BotFather. Токен бота поддержки сюда не годится:
# два процесса на одном токене выбивают друг друга.
BOT_TOKEN=

# Папка бота поддержки на этом сервере (там лежат data/ и admin_web/)
SUPPORT_DIR=/root/vpn_support_bot

# Чаты, где бот отвечает, через запятую (-100xxxxxxxxxx). Узнать: /chatid в чате.
CHAT_IDS=

# Ваш Telegram id и id операторов через запятую. Их сообщения в чате бот не
# перебивает, им доступны /status и проверка ответов в личке бота.
# Пока пусто, /chatid отвечает любому — так id и узнаются.
ADMIN_IDS=

# Как в .env бота поддержки: подставляются вместо {MAIN_BOT}, {BRAND_NAME}
# и т.п. в его промпте и текстах.
BRAND_NAME=
BRAND_SHORT=
MAIN_BOT_USERNAME=
COMMUNITY_CHAT_URL=
NEWS_CHANNEL_URL=

# Бот поддержки (без @). Задан — на вопросы про чужую подписку и оплату бот
# в чате направляет туда. Пусто — молчит, ответит оператор.
SUPPORT_BOT_USERNAME=

# ── Модель ────────────────────────────────────────────────────────
# Пусто — провайдер, ключ и модель берутся из админки поддержки (раздел AI).
# Задайте ключ с platform.openai.com, если чат должен платить отдельно
# или ключ поддержки лежит в её .env, а не в админке.
OPENAI_API_KEY=
# Пусто — модель из админки поддержки (или gpt-4o-mini)
AI_MODEL=
# Только для gpt-5*/o*: minimal | low | medium | high
REASONING_EFFORT=
# Свой адрес chat/completions, например прокси к OpenAI
AI_BASE_URL=

# ── Расход ────────────────────────────────────────────────────────
# true — к модели уходят только сообщения, похожие на вопрос
# («?», «сколько», «как», «цена», «тариф», «оплата»…). Остальное без затрат.
QUESTIONS_ONLY=true
# Не чаще одного запроса к модели от человека за столько секунд
USER_COOLDOWN=30
# Потолок запросов к модели в час на весь бот
MAX_CALLS_PER_HOUR=120

LOG_LEVEL=INFO
